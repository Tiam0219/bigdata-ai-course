# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# VSCode
.vscode/

# 系统文件
Thumbs.db
.DS_Store

# 数据文件（大文件不入库）
*.csv
*.xlsx
*.zip

# 敏感信息（严禁入库：密钥、凭据、个人数据）
.env
.env.*
*.pem
*.key
secrets/
credentials.json
service-account*.json
*_apikey*.txt

# 个人工作区数据（.workbuddy 仅共享 skills，其余为个人数据不入库）
.workbuddy/*
!.workbuddy/skills/
